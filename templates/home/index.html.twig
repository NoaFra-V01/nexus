{% extends 'base.html.twig' %}

{% block title %}Bienvenue sur NEXUS{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .ticket-card { border: 1px solid #ddd; padding: 15px; margin-bottom: 10px; border-radius: 5px; background: #fff; }
    .status-open { color: green; font-weight: bold; }
    .status-done { color: gray; text-decoration: line-through; }
</style>

<div class="example-wrapper">
    <h1>Tableau de bord NEXUS</h1>

    <h2>Derniers tickets</h2>

    {% for ticket in tickets%}
        <div class="ticket-card">
            <h3>#{{ ticket.id }} - {{ ticket.title}}</h3>

            <p>
                <strong>Status :</strong>
                <span class="{{ ticket.status == 'OPEN' ? 'status-open' : 'status-done'}}"> {{ ticket.status }}</span>

                <small>Crée le {{ ticket.createdAt|date('d/m/Y à H:i') }}</small>
            </p>

            <p>{{ ticket.description }}</p>
        </div>
      {%else%}
      <p>Aucun ticket dans la base</p> 
      {%endfor%} 
</div>
{% endblock %}
