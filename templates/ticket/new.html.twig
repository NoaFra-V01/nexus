{% extends 'base.html.twig' %}

{% block title %}Nouveau Ticket {% endblock %}

{% block body %}
<div style="max-width: 600px; margin:20px auto">
    <h1>Créer un nouveau ticket</h1>

    {{ form_start(form)}}

        {{form_errors(form)}}

        {{form_widget(form)}}

        <button type="submit" style="margin-top: 15px; padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">
            Sauvegarder le ticket
        </button>

        {{form_end(form)}}

        <p style="margin-top: 20px">
            <a href="{{ path('app_home') }}">Retour à la liste</a>
        </p>
</div>
{% endblock %}